#!/usr/bin/python3
"""Read-only GitHub process fixture; never contacts GitHub."""
import datetime
import json
import os
import sys
import time

args = sys.argv[1:]
assert args[:5] == ["api", "--hostname", "github.com", "--include", "graphql"]
assert os.environ.get("GH_PROMPT_DISABLED") == "1"
assert "GH_DEBUG" not in os.environ
time.sleep(0.1)
mode = os.environ.get("STATS_FIXTURE", "success")
if mode == "hang":
    time.sleep(60)
if mode == "auth":
    print('HTTP/2.0 401 Unauthorized\n\n{"message":"Bad credentials"}')
    sys.exit(1)
if mode == "network":
    print("error connecting to api.github.com: private-response-sentinel", file=sys.stderr)
    sys.exit(1)
if mode == "rate":
    print('HTTP/2.0 429 Too Many Requests\nRetry-After: 3600\n\n{"message":"rate limit exceeded"}')
    sys.exit(1)
identity = {"id": "U_fixture", "login": "fixture"}
data = {"viewer": identity}
if any("contributionsCollection" in arg for arg in args):
    assert "login=fixture" in args
    to = next(arg.split("=", 1)[1] for arg in args if arg.startswith("to="))
    today = datetime.datetime.fromisoformat(to).date()
    days = [{"date": (today - datetime.timedelta(days=offset)).isoformat(),
             "contributionCount": 8 if offset == 0 else 0,
             "contributionLevel": "SECOND_QUARTILE" if offset == 0 else "NONE"}
            for offset in range(369, -1, -1)]
    totals = {"totalCommitContributions": 3, "totalPullRequestContributions": 2, "totalIssueContributions": 1}
    data["user"] = dict(identity, contributionsCollection=dict(totals, contributionCalendar={
        "weeks": [{"contributionDays": days}]
    }), week=totals, month=totals)
print("HTTP/2.0 200 OK\nContent-Type: application/json\n\n" + json.dumps({"data": data}))
