#!/usr/bin/python3
"""Read-only GitHub process fixture; never contacts GitHub."""
import datetime
import json
import os
import sys
import time
from pathlib import Path

args = sys.argv[1:]
assert args[:5] == ["api", "--hostname", "github.com", "--include", "graphql"]
assert os.environ.get("GH_PROMPT_DISABLED") == "1"
assert "GH_DEBUG" not in os.environ
time.sleep(0.1)
mode = os.environ.get("STATS_FIXTURE", "success")
if mode == "stale" and "query=query { viewer { id login } }" in args:
    control = Path(os.environ["STATS_FIXTURE_CONTROL"])
    if control.exists():
        print("error connecting to api.github.com", file=sys.stderr)
        sys.exit(1)
    control.write_text("fixture identity already loaded")
if mode == "hang":
    time.sleep(60)
if mode == "auth":
    print('HTTP/2.0 401 Unauthorized\n\n{"message":"Bad credentials"}')
    sys.exit(1)
if mode == "network":
    print("error connecting to api.github.com: private-response-sentinel", file=sys.stderr)
    sys.exit(1)
if mode == "rate":
    print('HTTP/2.0 429 Too Many Requests\nRetry-After: 3600\n\n{"message":"rate limit exceeded"}')
    sys.exit(1)
identity = {"id": "U_fixture", "login": "fixture"}
data = {"viewer": identity}
if any("contributionsCollection" in arg for arg in args):
    assert "login=fixture" in args
    to = next(arg.split("=", 1)[1] for arg in args if arg.startswith("to="))
    today = datetime.datetime.fromisoformat(to).date()
    days = [{"date": (today - datetime.timedelta(days=offset)).isoformat(),
             "contributionCount": 8 if offset == 0 else 0,
             "contributionLevel": "SECOND_QUARTILE" if offset == 0 else "NONE"}
            for offset in range(369, -1, -1)]
    totals = {"totalCommitContributions": 3, "totalPullRequestContributions": 2, "totalIssueContributions": 1, "restrictedContributionsCount": 0}
    data["user"] = dict(identity, contributionsCollection=dict(totals, contributionCalendar={
        "weeks": [{"contributionDays": days}]
    }), week=totals, month=totals)
if any("repositories(first:" in arg for arg in args):
    second = "cursor=repo-next" in args
    language, size = ("Python", 40) if second else ("JavaScript", 60)
    repo = {"id": "R_second" if second else "R_first", "owner": identity, "isFork": False,
            "stargazerCount": 5 if second else 7, "languages": {"totalCount": 1,
            "pageInfo": {"hasNextPage": False, "endCursor": None},
            "edges": [{"size": size, "node": {"name": language}}]}}
    data["user"] = dict(identity, repositories={"nodes": [repo], "totalCount": 2,
        "pageInfo": {"hasNextPage": not second, "endCursor": "repo-last" if second else "repo-next"}})
if any("authored: search(" in arg for arg in args):
    issues = any("... on Issue {" in arg for arg in args)
    def pr(number, author):
        return {"__typename": "Issue" if issues else "PullRequest", "id": f"I_{number}" if issues else f"PR_{number}", "number": number,
                "title": f"Fixture Issue {number}" if issues else f"Fixture PR {number}",
                "url": f"https://github.com/fixture/repo/{'issues' if issues else 'pull'}/{number}",
                "updatedAt": "2026-10-25T09:00:00Z", "state": "OPEN", "isDraft": number == 1,
                "author": {"login": author}, "repository": {"nameWithOwner": "fixture/repo", "isPrivate": number == 1}}
    data.update(authored={"issueCount": 1, "nodes": [pr(1, "fixture")]},
                secondary={"issueCount": 1, "nodes": [pr(2, "other")]}, overlap={"nodes": [{"id": "I_1" if issues else "PR_1"}]})
print("HTTP/2.0 200 OK\nContent-Type: application/json\n\n" + json.dumps({"data": data}))
